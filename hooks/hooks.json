{
  "description": "Adversarial verification hooks — captures task on prompt, runs verification on stop",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/crucible-hooks.sh\" phase1 \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/crucible-hooks.sh\" phase2 \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 300,
            "asyncRewake": true
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/crucible-hooks.sh\" phase2-wait \"${CLAUDE_PLUGIN_ROOT}\"",
            "timeout": 300,
            "statusMessage": "Crucible: verifying your changes..."
          }
        ]
      }
    ]
  }
}
